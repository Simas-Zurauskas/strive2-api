{
  "name": "strive.api",
  "version": "1.3.2",
  "description": "",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node build/index.js",
    "dev": "nodemon --watch src --ext ts,tsx,scss --exec \"ts-node --files -r tsconfig-paths/register src/index.ts\"",
    "build": "rm -rf build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "tsc": "tsc --noEmit",
    "stripe:webhook": "stripe listen --forward-to http://localhost:4000/api/billing/stripe/webhook",
    "test": "vitest run",
    "debug:orchestrator": "ts-node --files -r tsconfig-paths/register scripts/debugOrchestrator/index.ts",
    "kb:index": "ts-node --files -r tsconfig-paths/register scripts/indexProductKb/index.ts",
    "kb:check": "ts-node --files -r tsconfig-paths/register scripts/indexProductKb/index.ts --check",
    "relaunch:import": "ts-node --files -r tsconfig-paths/register scripts/importRelaunchRecipients/index.ts --file ../wiki/working/prod.User.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/langchain": "^2.0.144",
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.32",
    "@langchain/langgraph": "^1.2.5",
    "@langchain/openai": "^1.2.13",
    "@langchain/tavily": "^1.2.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@sentry/node": "^10.38.0",
    "ai": "^6.0.143",
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "gray-matter": "^4.0.3",
    "helmet": "^8.1.0",
    "jsonrepair": "^3.14.0",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.16.45",
    "lodash": "^4.17.23",
    "mixpanel": "^0.22.0",
    "moment-timezone": "^0.6.0",
    "mongoose": "^9.2.1",
    "multer": "^2.0.2",
    "node-mailjet": "^6.0.11",
    "openai": "^6.35.0",
    "p-limit": "3",
    "socket.io": "^4.8.3",
    "stripe": "^22.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
